rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net Default Deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable global helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && 
        request.auth.token.email == 'nurmohammad.22.10.2007@gmail.com' && 
        request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- USERS COLLECTION ---
    match /users/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == uid && isValidUser(incoming());
      allow update: if (isSignedIn() && request.auth.uid == uid && isValidUser(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasAny(['username', 'avatar', 'coins', 'totalScore', 'achievements'])
      )) || isAdmin();
      allow delete: if isAdmin();
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'username', 'email', 'avatar', 'coins', 'totalScore', 'achievements', 'createdAt'])
        && data.keys().size() == 8
        && data.uid == request.auth.uid
        && data.username is string && data.username.size() >= 1 && data.username.size() <= 32
        && data.email is string && data.email.size() <= 128
        && data.avatar is string && data.avatar.size() <= 128
        && data.coins is int && data.coins >= 0
        && data.totalScore is int && data.totalScore >= 0
        && data.achievements is list;
    }

    // --- LEADERBOARDS COLLECTION ---
    match /leaderboards/{entryId} {
      allow read, list: if true; // Publicly readable for global lists
      allow create: if isSignedIn() 
        && isValidId(entryId) 
        && isValidLeaderboardEntry(incoming()) 
        && incoming().uid == request.auth.uid;
      allow update, delete: if isAdmin(); // scores are standard immutable records for common clients, but admins can manage
    }

    function isValidLeaderboardEntry(data) {
      return data.keys().hasAll(['uid', 'username', 'game', 'score', 'createdAt'])
        && data.keys().size() == 5
        && data.uid == request.auth.uid
        && data.username is string && data.username.size() >= 1 && data.username.size() <= 32
        && data.game is string && data.game.size() <= 128
        && data.score is int && data.score >= 0;
    }

    // --- ACHIEVEMENTS COLLECTION ---
    match /achievements/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if (isSignedIn() && request.auth.uid == uid && isValidAchievements(incoming())) || isAdmin();
      allow delete: if isAdmin();
    }

    function isValidAchievements(data) {
      return data.keys().hasAll(['uid', 'list'])
        && data.uid == request.auth.uid
        && data.list is list;
    }

    // --- GAME PROGRESS COLLECTION ---
    match /gameProgress/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if (isSignedIn() && request.auth.uid == uid && isValidGameProgress(incoming())) || isAdmin();
      allow delete: if isAdmin();
    }

    function isValidGameProgress(data) {
      return data.keys().hasAll(['uid', 'stats'])
        && data.uid == request.auth.uid
        && data.stats is map;
    }

    // --- SKINS COLLECTION ---
    match /skins/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if (isSignedIn() && request.auth.uid == uid && isValidSkins(incoming())) || isAdmin();
      allow delete: if isAdmin();
    }

    function isValidSkins(data) {
      return data.keys().hasAll(['uid', 'list'])
        && data.uid == request.auth.uid
        && data.list is list;
    }

    // --- SETTINGS COLLECTION ---
    match /settings/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if (isSignedIn() && request.auth.uid == uid && isValidSettings(incoming())) || isAdmin();
      allow delete: if isAdmin();
    }

    function isValidSettings(data) {
      return data.keys().hasAll(['uid', 'settings'])
        && data.uid == request.auth.uid
        && data.settings is map;
    }
  }
}
