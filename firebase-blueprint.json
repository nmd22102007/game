{
  "entities": {
    "User": {
      "title": "User",
      "description": "Authenticated user profile in NURMD hub",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string"
        },
        "username": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "avatar": {
          "type": "string"
        },
        "coins": {
          "type": "integer"
        },
        "totalScore": {
          "type": "integer"
        },
        "achievements": {
          "type": "array"
        },
        "createdAt": {
          "type": "object"
        }
      },
      "required": [
        "uid",
        "username",
        "email",
        "avatar",
        "coins",
        "totalScore",
        "achievements",
        "createdAt"
      ]
    },
    "Leaderboard": {
      "title": "Leaderboard",
      "description": "Leaderboard score record",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string"
        },
        "username": {
          "type": "string"
        },
        "game": {
          "type": "string"
        },
        "score": {
          "type": "integer"
        },
        "createdAt": {
          "type": "object"
        }
      },
      "required": [
        "uid",
        "username",
        "game",
        "score",
        "createdAt"
      ]
    },
    "AchievementsProgress": {
      "title": "AchievementsProgress",
      "description": "The user's individual unlocked achievements logs",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string"
        },
        "list": {
          "type": "array"
        }
      },
      "required": [
        "uid",
        "list"
      ]
    },
    "GameProgress": {
      "title": "GameProgress",
      "description": "The high scores and play counters for all games",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string"
        },
        "stats": {
          "type": "object"
        }
      },
      "required": [
        "uid",
        "stats"
      ]
    },
    "SkinsProgress": {
      "title": "SkinsProgress",
      "description": "Collection of unearned and custom equipped assets skins",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string"
        },
        "list": {
          "type": "array"
        }
      },
      "required": [
        "uid",
        "list"
      ]
    },
    "SettingsState": {
      "title": "SettingsState",
      "description": "Volume configuration and high-contrast toggles",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string"
        },
        "settings": {
          "type": "object"
        }
      },
      "required": [
        "uid",
        "settings"
      ]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "User",
      "description": "Primary identity records for a given UID"
    },
    "/leaderboards/{entryId}": {
      "schema": "Leaderboard",
      "description": "Aggregated historic game scores"
    },
    "/achievements/{uid}": {
      "schema": "AchievementsProgress",
      "description": "Array of logged achievements"
    },
    "/gameProgress/{uid}": {
      "schema": "GameProgress",
      "description": "Breakdown of plays/wins metrics"
    },
    "/skins/{uid}": {
      "schema": "SkinsProgress",
      "description": "Unlocked status variables of elements"
    },
    "/settings/{uid}": {
      "schema": "SettingsState",
      "description": "Audio volumes parameters"
    }
  }
}
